# =====================================================
# SMS Hindi Shayari
# Environment Variables
# =====================================================

# Application
NODE_ENV=development
PORT=3000
SITE_NAME=SMS Hindi Shayari
SITE_URL=http://localhost:3000

# MongoDB
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/sms_hindi_shayari

# Admin Login
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeThisPassword123

# Session
SESSION_SECRET=change_this_to_a_long_random_secret_key

# JWT
JWT_SECRET=change_this_to_a_long_random_jwt_secret
JWT_EXPIRES_IN=7d

# GitHub
GITHUB_TOKEN=github_personal_access_token
GITHUB_USERNAME=your_github_username
GITHUB_REPOSITORY=sms-hindi-shayari-assets
GITHUB_BRANCH=main
GITHUB_BACKGROUND_FOLDER=backgrounds

# AI Image Generator
DEFAULT_FONT=NotoSansDevanagari-Bold.ttf
DEFAULT_TEXT_COLOR=#FFFFFF
DEFAULT_STROKE_COLOR=#000000
DEFAULT_SHADOW=true

# Upload
MAX_UPLOAD_SIZE=10485760

# Google AdSense
ADSENSE_CLIENT=ca-pub-xxxxxxxxxxxxxxxx

# Google Analytics
GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Mail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=example@gmail.com
SMTP_PASS=your_app_password

# SEO
DEFAULT_LANGUAGE=hi
DEFAULT_TITLE=SMS Hindi Shayari
DEFAULT_DESCRIPTION=Read and Download Beautiful Hindi Shayari Images.
DEFAULT_KEYWORDS=hindi shayari,love shayari,sad shayari,status

# PWA
PWA_THEME_COLOR=#e53935
PWA_BACKGROUND_COLOR=#ffffff
