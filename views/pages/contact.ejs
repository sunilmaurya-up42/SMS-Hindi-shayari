<section class="py-5">
    <div class="container">

        <div class="row justify-content-center">

            <div class="col-lg-8">

                <div class="card shadow-sm border-0">

                    <div class="card-body p-4 p-md-5">

                        <h1 class="fw-bold mb-3">
                            Contact Us
                        </h1>

                        <p class="text-muted mb-4">
                            किसी सवाल, सुझाव या समस्या के लिए हमसे
                            संपर्क करें।
                        </p>

                        <form action="/contact" method="POST">

                            <% if (typeof csrfToken !== "undefined") { %>
                                <input
                                    type="hidden"
                                    name="_csrf"
                                    value="<%= csrfToken %>">
                            <% } %>

                            <div class="mb-3">

                                <label class="form-label">
                                    Name
                                </label>

                                <input
                                    type="text"
                                    name="name"
                                    class="form-control"
                                    required
                                    maxlength="100">

                            </div>

                            <div class="mb-3">

                                <label class="form-label">
                                    Email
                                </label>

                                <input
                                    type="email"
                                    name="email"
                                    class="form-control"
                                    required
                                    maxlength="150">

                            </div>

                            <div class="mb-3">

                                <label class="form-label">
                                    Subject
                                </label>

                                <input
                                    type="text"
                                    name="subject"
                                    class="form-control"
                                    maxlength="200">

                            </div>

                            <div class="mb-4">

                                <label class="form-label">
                                    Message
                                </label>

                                <textarea
                                    name="message"
                                    class="form-control"
                                    rows="6"
                                    required
                                    maxlength="3000"></textarea>

                            </div>

                            <button
                                type="submit"
                                class="btn btn-primary">

                                <i class="fa-solid fa-paper-plane me-1"></i>
                                Send Message

                            </button>

                        </form>

                    </div>

                </div>

            </div>

        </div>

    </div>
</section>
