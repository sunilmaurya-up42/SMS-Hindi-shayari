<section class="py-5">
  <div class="container">
    <div class="text-center mb-5">
      <h1 class="fw-bold">Festival Shayari</h1>
      <p class="text-muted">त्योहारों और खास मौकों के लिए खूबसूरत शायरी।</p>
    </div>
    <div class="row">
      <% if (festivalShayari && festivalShayari.length) { %>
        <% festivalShayari.forEach(item => { %>
          <div class="col-lg-4 col-md-6 mb-4">
            <div class="card h-100 shadow-sm">
              <% if (item.imageUrl) { %><img src="<%= item.imageUrl %>" class="card-img-top" alt="<%= item.title %>"><% } %>
              <div class="card-body">
                <h5><%= item.title %></h5>
                <p><%= (item.content || "").substring(0,160) %>...</p>
                <a href="/shayari/<%= item.slug %>" class="btn btn-primary btn-sm">Read More</a>
              </div>
            </div>
          </div>
        <% }) %>
      <% } else { %>
        <div class="col-12"><div class="alert alert-info text-center">अभी Festival Shayari उपलब्ध नहीं है।</div></div>
      <% } %>
    </div>
  </div>
</section>
