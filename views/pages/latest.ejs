<section class="py-4">
    <div class="container">

        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h1 class="fw-bold mb-1">Latest Shayari</h1>
                <p class="text-muted mb-0">
                    हमारी नवीनतम हिंदी शायरी पढ़ें।
                </p>
            </div>

            <a href="/" class="btn btn-outline-primary">
                <i class="fa-solid fa-house me-1"></i>
                Home
            </a>
        </div>

        <% if (latestShayari && latestShayari.length) { %>

            <div class="row">

                <% latestShayari.forEach(item => { %>

                    <div class="col-lg-4 col-md-6 mb-4">

                        <article class="card h-100 shadow-sm border-0">

                            <% if (item.imageUrl) { %>
                                <img
                                    src="<%= item.imageUrl %>"
                                    class="card-img-top"
                                    alt="<%= item.title %>"
                                    loading="lazy">
                            <% } %>

                            <div class="card-body">

                                <h2 class="h5 fw-bold">
                                    <%= item.title %>
                                </h2>

                                <p class="text-muted">
                                    <%= (item.content || "").substring(0, 180) %>
                                    <% if ((item.content || "").length > 180) { %>...<% } %>
                                </p>

                                <a
                                    href="/shayari/<%= item.slug %>"
                                    class="btn btn-primary">

                                    Read More
                                    <i class="fa-solid fa-arrow-right ms-1"></i>

                                </a>

                            </div>

                        </article>

                    </div>

                <% }) %>

            </div>

        <% } else { %>

            <div class="alert alert-info text-center">
                <i class="fa-solid fa-circle-info me-2"></i>
                अभी कोई Latest Shayari उपलब्ध नहीं है।
            </div>

        <% } %>

    </div>
</section>
