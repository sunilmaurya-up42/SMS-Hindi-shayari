<section class="py-4">
    <div class="container">

        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h1 class="fw-bold mb-1">Popular Shayari</h1>
                <p class="text-muted mb-0">
                    सबसे ज्यादा पसंद की जाने वाली शायरी।
                </p>
            </div>

            <a href="/" class="btn btn-outline-primary">
                <i class="fa-solid fa-house me-1"></i>
                Home
            </a>
        </div>

        <% if (popularShayari && popularShayari.length) { %>

            <div class="row">

                <% popularShayari.forEach(item => { %>

                    <div class="col-lg-4 col-md-6 mb-4">

                        <article class="card h-100 shadow-sm border-0">

                            <% if (item.imageUrl) { %>

                                <img
                                    src="<%= item.imageUrl %>"
                                    class="card-img-top"
                                    alt="<%= item.title %>"
                                    loading="lazy">

                            <% } %>

                            <div class="card-body">

                                <h2 class="h5 fw-bold">
                                    <%= item.title %>
                                </h2>

                                <p class="text-muted">
                                    <%= (item.content || "").substring(0, 180) %>
                                    <% if ((item.content || "").length > 180) { %>...<% } %>
                                </p>

                                <div class="d-flex justify-content-between align-items-center">

                                    <a
                                        href="/shayari/<%= item.slug %>"
                                        class="btn btn-primary">

                                        Read More
                                        <i class="fa-solid fa-arrow-right ms-1"></i>

                                    </a>

                                    <% if (typeof item.views !== "undefined") { %>

                                        <small class="text-muted">
                                            <i class="fa-solid fa-eye me-1"></i>
                                            <%= item.views %>
                                        </small>

                                    <% } %>

                                </div>

                            </div>

                        </article>

                    </div>

                <% }) %>

            </div>

        <% } else { %>

            <div class="alert alert-info text-center">
                <i class="fa-solid fa-circle-info me-2"></i>
                अभी कोई Popular Shayari उपलब्ध नहीं है।
            </div>

        <% } %>

    </div>
</section>
