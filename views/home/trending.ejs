<section class="py-5">

    <div class="container">

        <!-- Header -->
        <div class="d-flex justify-content-between align-items-center flex-wrap mb-4">

            <div>

                <h1 class="fw-bold">

                    🔥 Trending Shayari

                </h1>

                <p class="text-muted mb-0">

                    Most trending Shayari based on views, likes and shares.

                </p>

            </div>

            <form
                action="/trending"
                method="GET"
                class="mt-3 mt-md-0">

                <select
                    name="range"
                    class="form-select"
                    onchange="this.form.submit()">

                    <option
                        value="24h"
                        <%= range === "24h" ? "selected" : "" %>>

                        Last 24 Hours

                    </option>

                    <option
                        value="7d"
                        <%= range === "7d" ? "selected" : "" %>>

                        Last 7 Days

                    </option>

                    <option
                        value="30d"
                        <%= range === "30d" ? "selected" : "" %>>

                        Last 30 Days

                    </option>

                    <option
                        value="all"
                        <%= range === "all" ? "selected" : "" %>>

                        All Time

                    </option>

                </select>

            </form>

        </div>

        <div class="row">

            <% if (trendingShayari && trendingShayari.length) { %>

                <% trendingShayari.forEach((item,index)=>{ %>

                    <div class="col-lg-6 mb-4">

                        <div class="card shadow-sm h-100">

                            <% if(item.imageUrl){ %>

                                <img
                                    src="<%= item.imageUrl %>"
                                    class="card-img-top"
                                    alt="<%= item.title %>">

                            <% } %>

                            <div class="card-body">

                                <div class="d-flex justify-content-between mb-3">

                                    <span class="badge bg-danger">

                                        🔥 Rank #<%= index + 1 + ((pagination.page-1) * pagination.limit) %>

                                    </span>

                                    <span class="badge bg-primary">

                                        <%= item.category?.name || "General" %>

                                    </span>

                                </div>

                                <h4>

                                    <%= item.title %>

                                </h4>

                                <p>

                                    <%= item.content.substring(0,180) %>...

                                </p>

                                <div class="row text-center my-3">

                                    <div class="col">

                                        <i class="fa-solid fa-eye"></i>

                                        <br>

                                        <strong>

                                            <%= item.views || 0 %>

                                        </strong>

                                    </div>

                                    <div class="col">

                                        <i class="fa-solid fa-heart text-danger"></i>

                                        <br>

                                        <strong>

                                            <%= item.likes || 0 %>

                                        </strong>

                                    </div>

                                    <div class="col">

                                        <i class="fa-solid fa-share-nodes text-success"></i>

                                        <br>

                                        <strong>

                                            <%= item.shares || 0 %>

                                        </strong>

                                    </div>

                                    <div class="col">

                                        <i class="fa-solid fa-fire text-warning"></i>

                                        <br>

                                        <strong>

                                            <%= item.trendingScore || 0 %>

                                        </strong>

                                    </div>

                                </div>

                                <div class="d-flex justify-content-between align-items-center">

                                    <small class="text-muted">

                                        <i class="fa-solid fa-calendar"></i>

                                        <%= new Date(item.createdAt).toLocaleDateString() %>

                                    </small>

                                    <a
                                        href="/shayari/<%= item.slug %>"
                                        class="btn btn-danger">

                                        Read More

                                    </a>

                                </div>

                            </div>

                        </div>

                    </div>

                <% }) %>

            <% } else { %>

                <div class="col-12">

                    <div class="alert alert-warning text-center">

                        No Trending Shayari Available.

                    </div>

                </div>

            <% } %>

        </div>

        <!-- Pagination -->

        <% if (pagination && pagination.totalPages > 1) { %>

            <nav class="mt-4">

                <ul class="pagination justify-content-center">

                    <% for(let i=1;i<=pagination.totalPages;i++){ %>

                        <li class="page-item <%= pagination.page===i ? 'active' : '' %>">

                            <a
                                class="page-link"
                                href="?page=<%= i %>&range=<%= range %>">

                                <%= i %>

                            </a>

                        </li>

                    <% } %>

                </ul>

            </nav>

        <% } %>

    </div>

</section>
