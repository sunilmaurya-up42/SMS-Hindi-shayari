<section class="py-5">

    <div class="container">

        <!-- Page Header -->
        <div class="d-flex justify-content-between align-items-center mb-4">

            <div>

                <h1 class="fw-bold">

                    Popular Shayari

                </h1>

                <p class="text-muted mb-0">

                    Most viewed and liked Hindi Shayari.

                </p>

            </div>

            <form
                action="/popular"
                method="GET"
                class="d-flex">

                <select
                    name="sort"
                    class="form-select"
                    onchange="this.form.submit()">

                    <option
                        value="views"
                        <%= sort === "views" ? "selected" : "" %>>

                        Most Viewed

                    </option>

                    <option
                        value="likes"
                        <%= sort === "likes" ? "selected" : "" %>>

                        Most Liked

                    </option>

                    <option
                        value="trending"
                        <%= sort === "trending" ? "selected" : "" %>>

                        Trending

                    </option>

                </select>

            </form>

        </div>

        <div class="row">

            <% if (popularShayari && popularShayari.length) { %>

                <% popularShayari.forEach((item, index) => { %>

                    <div class="col-lg-6 mb-4">

                        <div class="card shadow-sm h-100">

                            <% if (item.imageUrl) { %>

                                <img
                                    src="<%= item.imageUrl %>"
                                    class="card-img-top"
                                    alt="<%= item.title %>">

                            <% } %>

                            <div class="card-body">

                                <div class="d-flex justify-content-between align-items-start mb-2">

                                    <span class="badge bg-warning text-dark">

                                        #<%= index + 1 + ((pagination.page - 1) * pagination.limit) %>

                                    </span>

                                    <span class="badge bg-primary">

                                        <%= item.category?.name || "General" %>

                                    </span>

                                </div>

                                <h4>

                                    <%= item.title %>

                                </h4>

                                <p>

                                    <%= item.content.substring(0, 180) %>...

                                </p>

                                <div class="row text-center mb-3">

                                    <div class="col">

                                        <i class="fa-solid fa-eye"></i>

                                        <br>

                                        <strong>

                                            <%= item.views || 0 %>

                                        </strong>

                                    </div>

                                    <div class="col">

                                        <i class="fa-solid fa-heart text-danger"></i>

                                        <br>

                                        <strong>

                                            <%= item.likes || 0 %>

                                        </strong>

                                    </div>

                                    <div class="col">

                                        <i class="fa-solid fa-share-nodes text-success"></i>

                                        <br>

                                        <strong>

                                            <%= item.shares || 0 %>

                                        </strong>

                                    </div>

                                </div>

                                <div class="d-flex justify-content-between">

                                    <small class="text-muted">

                                        <i class="fa-solid fa-calendar"></i>

                                        <%= new Date(item.createdAt).toLocaleDateString() %>

                                    </small>

                                    <a
                                        href="/shayari/<%= item.slug %>"
                                        class="btn btn-primary btn-sm">

                                        Read More

                                    </a>

                                </div>

                            </div>

                        </div>

                    </div>

                <% }) %>

            <% } else { %>

                <div class="col-12">

                    <div class="alert alert-warning text-center">

                        No Popular Shayari Found.

                    </div>

                </div>

            <% } %>

        </div>

        <!-- Pagination -->

        <% if (pagination && pagination.totalPages > 1) { %>

            <nav>

                <ul class="pagination justify-content-center">

                    <% for (let i = 1; i <= pagination.totalPages; i++) { %>

                        <li
                            class="page-item <%= pagination.page === i ? 'active' : '' %>">

                            <a
                                class="page-link"
                                href="?page=<%= i %>&sort=<%= sort %>">

                                <%= i %>

                            </a>

                        </li>

                    <% } %>

                </ul>

            </nav>

        <% } %>

    </div>

</section>
