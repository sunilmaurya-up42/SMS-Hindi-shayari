<nav class="navbar navbar-expand-lg navbar-dark bg-primary sticky-top">
    <div class="container">

        <!-- Mobile Brand -->
        <a class="navbar-brand fw-bold d-lg-none" href="/">
            SMS Hindi Shayari
        </a>

        <!-- Mobile Toggle -->
        <button
            class="navbar-toggler"
            type="button"
            data-bs-toggle="collapse"
            data-bs-target="#mainNavbar"
            aria-controls="mainNavbar"
            aria-expanded="false"
            aria-label="Toggle navigation">

            <span class="navbar-toggler-icon"></span>
        </button>

        <!-- Navbar Menu -->
        <div class="collapse navbar-collapse" id="mainNavbar">

            <ul class="navbar-nav me-auto mb-2 mb-lg-0">

                <!-- Home -->
                <li class="nav-item">
                    <a
                        href="/"
                        class="nav-link <%= (typeof activePage !== 'undefined' && activePage === 'home') ? 'active' : '' %>">

                        <i class="fa-solid fa-house me-1"></i>
                        Home
                    </a>
                </li>

                <!-- Latest -->
                <li class="nav-item">
                    <a
                        href="/latest"
                        class="nav-link <%= (typeof activePage !== 'undefined' && activePage === 'latest') ? 'active' : '' %>">

                        Latest
                    </a>
                </li>

                <!-- Popular -->
                <li class="nav-item">
                    <a
                        href="/popular"
                        class="nav-link <%= (typeof activePage !== 'undefined' && activePage === 'popular') ? 'active' : '' %>">

                        Popular
                    </a>
                </li>

                <!-- Categories -->
                <li class="nav-item dropdown">

                    <a
                        href="#"
                        class="nav-link dropdown-toggle"
                        role="button"
                        data-bs-toggle="dropdown"
                        aria-expanded="false">

                        Categories
                    </a>

                    <ul class="dropdown-menu">
                        <li>
                            <a class="dropdown-item fw-semibold" href="/categories">
                                <i class="fa-solid fa-layer-group me-2"></i>
                                All Categories
                            </a>
                        </li>
                        <li><hr class="dropdown-divider"></li>

                        <% if (typeof categories !== 'undefined' && categories && categories.length) { %>

                            <% categories.forEach(category => { %>

                                <li>
                                    <a
                                        class="dropdown-item"
                                        href="/category/<%= category.slug %>">

                                        <%= category.name %>

                                    </a>
                                </li>

                            <% }) %>

                        <% } else { %>

                            <li>
                                <span class="dropdown-item-text text-muted">
                                    No Categories
                                </span>
                            </li>

                        <% } %>

                    </ul>
                </li>

                <!-- Festival -->
                <li class="nav-item">
                    <a
                        href="/festival"
                        class="nav-link <%= (typeof activePage !== 'undefined' && activePage === 'festival') ? 'active' : '' %>">

                        Festival
                    </a>
                </li>

                <!-- About -->
                <li class="nav-item">
                    <a
                        href="/about"
                        class="nav-link <%= (typeof activePage !== 'undefined' && activePage === 'about') ? 'active' : '' %>">

                        About
                    </a>
                </li>

                <!-- Contact -->
                <li class="nav-item">
                    <a
                        href="/contact"
                        class="nav-link <%= (typeof activePage !== 'undefined' && activePage === 'contact') ? 'active' : '' %>">

                        Contact
                    </a>
                </li>

            </ul>

            <!-- Mobile Search -->
            <form
                action="/search"
                method="GET"
                class="d-flex d-lg-none mt-3 mb-3">

                <input
                    class="form-control me-2"
                    type="search"
                    name="q"
                    placeholder="Search Shayari"
                    value="<%= typeof query !== 'undefined' ? query : '' %>"
                    autocomplete="off">

                <button
                    class="btn btn-light"
                    type="submit">

                    <i class="fa-solid fa-search"></i>
                </button>

            </form>

        </div>
    </div>
</nav>
