<section class="py-4">

    <div class="container-fluid">

        <!-- Header -->

        <div class="d-flex justify-content-between align-items-center flex-wrap mb-4">

            <div>

                <h2 class="fw-bold">

                    System Logs

                </h2>

                <p class="text-muted mb-0">

                    Monitor application, security and user activity logs.

                </p>

            </div>

            <div class="d-flex gap-2">

                <a
                    href="/admin/logs/download"
                    class="btn btn-success">

                    <i class="fa-solid fa-download"></i>

                    Download Logs

                </a>

                <form
                    action="/admin/logs/clear"
                    method="POST"
                    onsubmit="return confirm('Are you sure you want to clear all logs?');">

                    <input
                        type="hidden"
                        name="_csrf"
                        value="<%= csrfToken %>">

                    <button
                        class="btn btn-danger">

                        <i class="fa-solid fa-trash"></i>

                        Clear Logs

                    </button>

                </form>

            </div>

        </div>

        <!-- Filters -->

        <div class="card shadow-sm mb-4">

            <div class="card-body">

                <form
                    action="/admin/logs"
                    method="GET">

                    <div class="row g-3">

                        <div class="col-lg-3">

                            <input
                                type="text"
                                name="q"
                                value="<%= query || '' %>"
                                class="form-control"
                                placeholder="Search logs...">

                        </div>

                        <div class="col-lg-2">

                            <select
                                name="type"
                                class="form-select">

                                <option value="">

                                    All Types

                                </option>

                                <option value="login">

                                    Login

                                </option>

                                <option value="activity">

                                    Activity

                                </option>

                                <option value="security">

                                    Security

                                </option>

                                <option value="error">

                                    Error

                                </option>

                            </select>

                        </div>

                        <div class="col-lg-2">

                            <input
                                type="date"
                                name="from"
                                value="<%= from || '' %>"
                                class="form-control">

                        </div>

                        <div class="col-lg-2">

                            <input
                                type="date"
                                name="to"
                                value="<%= to || '' %>"
                                class="form-control">

                        </div>

                        <div class="col-lg-3">

                            <button
                                class="btn btn-primary w-100">

                                Apply Filter

                            </button>

                        </div>

                    </div>

                </form>

            </div>

        </div>

        <!-- Logs Table -->

        <div class="card shadow-sm">

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">

                        <tr>

                            <th>Date & Time</th>

                            <th>Type</th>

                            <th>User</th>

                            <th>IP Address</th>

                            <th>Message</th>

                            <th>Status</th>

                        </tr>

                    </thead>

                    <tbody>

                        <% if(logs.length){ %>

                            <% logs.forEach(log=>{ %>

                                <tr>

                                    <td>

                                        <%= new Date(log.createdAt).toLocaleString() %>

                                    </td>

                                    <td>

                                        <% if(log.type==="login"){ %>

                                            <span class="badge bg-primary">

                                                Login

                                            </span>

                                        <% } else if(log.type==="activity"){ %>

                                            <span class="badge bg-info">

                                                Activity

                                            </span>

                                        <% } else if(log.type==="security"){ %>

                                            <span class="badge bg-warning text-dark">

                                                Security

                                            </span>

                                        <% } else { %>

                                            <span class="badge bg-danger">

                                                Error

                                            </span>

                                        <% } %>

                                    </td>

                                    <td>

                                        <%= log.user?.name || "System" %>

                                    </td>

                                    <td>

                                        <code>

                                            <%= log.ip || "-" %>

                                        </code>

                                    </td>

                                    <td>

                                        <%= log.message %>

                                    </td>

                                    <td>

                                        <% if(log.success){ %>

                                            <span class="badge bg-success">

                                                Success

                                            </span>

                                        <% } else { %>

                                            <span class="badge bg-danger">

                                                Failed

                                            </span>

                                        <% } %>

                                    </td>

                                </tr>

                            <% }) %>

                        <% } else { %>

                            <tr>

                                <td
                                    colspan="6"
                                    class="text-center py-5">

                                    No logs found.

                                </td>

                            </tr>

                        <% } %>

                    </tbody>

                </table>

            </div>

        </div>

        <!-- Pagination -->

        <% if(pagination && pagination.totalPages > 1){ %>

            <nav class="mt-4">

                <ul class="pagination justify-content-center">

                    <% for(let i=1;i<=pagination.totalPages;i++){ %>

                        <li class="page-item <%= pagination.page===i ? 'active' : '' %>">

                            <a
                                class="page-link"
                                href="?page=<%= i %>">

                                <%= i %>

                            </a>

                        </li>

                    <% } %>

                </ul>

            </nav>

        <% } %>

    </div>

</section>
