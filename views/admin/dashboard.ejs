        </div>

        <!-- Background Upload -->

<div class="card shadow-sm mb-4">

    <div class="card-header d-flex justify-content-between align-items-center">

        <strong>
            <i class="fa-solid fa-image me-1"></i>
            Background Images
        </strong>

        <span class="badge bg-info">
            GitHub Storage
        </span>

    </div>


    <div class="card-body">

        <form
    id="backgroundUploadForm"
    method="POST"
    action="/background/upload"
    enctype="multipart/form-data">
            <input
                type="hidden"
                name="_csrf"
                value="<%= csrfToken %>">


            <div class="row g-3 align-items-end">

                <div class="col-md-4">

                    <label
                        for="backgroundTitle"
                        class="form-label">

                        Background Title

                    </label>

                    <input
                        type="text"
                        id="backgroundTitle"
                        name="title"
                        class="form-control"
                        placeholder="Example: Raksha Bandhan"
                        required>

                </div>


                <div class="col-md-5">

                    <label
                        for="backgroundFile"
                        class="form-label">

                        Background Image

                    </label>

                    <input
                        type="file"
                        id="backgroundFile"
                        name="background"
                        class="form-control"
                        accept="image/jpeg,image/png,image/webp"
                        required>

                    <div class="form-text">

                        JPG, PNG या WebP image चुनें।

                    </div>

                </div>


                <div class="col-md-3">

                    <button
                        type="submit"
                        id="backgroundUploadButton"
                        class="btn btn-primary w-100">

                        <i class="fa-solid fa-cloud-arrow-up me-1"></i>

                        Upload Background

                    </button>

                </div>

            </div>

        </form>


        <div
            id="backgroundUploadMessage"
            class="mt-3"
            style="display:none;">
        </div>

    </div>

</div>
        <script>
(function () {

    const form = document.getElementById("backgroundUploadForm");
    const button = document.getElementById("backgroundUploadButton");
    const message = document.getElementById("backgroundUploadMessage");

    if (!form) {
        return;
    }

    form.addEventListener("submit", async function (event) {

        event.preventDefault();

        const fileInput = document.getElementById("backgroundFile");

        if (!fileInput || !fileInput.files.length) {

            message.className = "alert alert-danger mt-3";
            message.textContent = "Please select a background image.";
            message.style.display = "block";

            return;
        }

        const csrfInput = form.querySelector(
            'input[name="_csrf"]'
        );

        const csrfToken = csrfInput
            ? csrfInput.value
            : "";

        if (!csrfToken) {

            message.className = "alert alert-danger mt-3";
            message.textContent =
                "CSRF token missing. Please refresh the page.";
            message.style.display = "block";

            return;
        }

        const formData = new FormData(form);

        button.disabled = true;

        button.innerHTML =
            '<span class="spinner-border spinner-border-sm me-1"></span> Uploading...';

        message.style.display = "none";

        try {

            const response = await fetch(
                "/background/upload",
                {
                    method: "POST",

                    headers: {
                        "X-CSRF-Token": csrfToken
                    },

                    body: formData,

                    credentials: "same-origin"
                }
            );

            const result = await response.json();

            if (!response.ok || !result.success) {

                throw new Error(
                    result.message ||
                    "Background upload failed."
                );
            }

            message.className =
                "alert alert-success mt-3";

            message.textContent =
                "✅ Background successfully uploaded to GitHub.";

            message.style.display = "block";

            form.reset();

        } catch (error) {

            console.error(
                "Background Upload Error:",
                error
            );

            message.className =
                "alert alert-danger mt-3";

            message.textContent =
                "❌ " +
                (
                    error.message ||
                    "Background upload failed."
                );

            message.style.display = "block";

        } finally {

            button.disabled = false;

            button.innerHTML =
                '<i class="fa-solid fa-cloud-arrow-up me-1"></i> Upload Background';

        }

    });

})();
</script>
        <!-- Charts -->

