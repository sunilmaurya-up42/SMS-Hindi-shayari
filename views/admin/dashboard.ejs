<section class="py-4">

    <div class="container-fluid">

        <!-- Header -->

        <div class="d-flex justify-content-between align-items-center mb-4">

            <div>

                <h2 class="fw-bold">

                    Admin Dashboard

                </h2>

                <p class="text-muted mb-0">

                    Welcome, <%= user.name %>

                </p>

            </div>

            <div>

                <a
                    href="/admin/shayari/new"
                    class="btn btn-primary">

                    <i class="fa-solid fa-plus"></i>

                    New Shayari

                </a>

            </div>

        </div>

        <!-- Statistics -->

        <div class="row g-4 mb-4">

            <div class="col-lg-3 col-md-6">

                <div class="card shadow-sm">

                    <div class="card-body text-center">

                        <i class="fa-solid fa-book fa-2x text-primary mb-2"></i>

                        <h3>

                            <%= stats.shayari %>

                        </h3>

                        <p class="mb-0">

                            Total Shayari

                        </p>

                    </div>

                </div>

            </div>

            <div class="col-lg-3 col-md-6">

                <div class="card shadow-sm">

                    <div class="card-body text-center">

                        <i class="fa-solid fa-users fa-2x text-success mb-2"></i>

                        <h3>

                            <%= stats.users %>

                        </h3>

                        <p class="mb-0">

                            Users

                        </p>

                    </div>

                </div>

            </div>

            <div class="col-lg-3 col-md-6">

                <div class="card shadow-sm">

                    <div class="card-body text-center">

                        <i class="fa-solid fa-comments fa-2x text-warning mb-2"></i>

                        <h3>

                            <%= stats.comments %>

                        </h3>

                        <p class="mb-0">

                            Comments

                        </p>

                    </div>

                </div>

            </div>

            <div class="col-lg-3 col-md-6">

                <div class="card shadow-sm">

                    <div class="card-body text-center">

                        <i class="fa-solid fa-image fa-2x text-danger mb-2"></i>

                        <h3>

                            <%= stats.images %>

                        </h3>

                        <p class="mb-0">

                            Images

                        </p>

                    </div>

                </div>

            </div>

        </div>

        <!-- Charts -->

        <div class="row mb-4">

            <div class="col-lg-8">

                <div class="card shadow-sm">

                    <div class="card-header">

                        Traffic Overview

                    </div>

                    <div class="card-body">

                        <canvas id="trafficChart" height="120"></canvas>

                    </div>

                </div>

            </div>

            <div class="col-lg-4">

                <div class="card shadow-sm">

                    <div class="card-header">

                        Category Distribution

                    </div>

                    <div class="card-body">

                        <canvas id="categoryChart"></canvas>

                    </div>

                </div>

            </div>

        </div>

        <!-- Recent Data -->

        <div class="row">

            <div class="col-lg-6">

                <div class="card shadow-sm mb-4">

                    <div class="card-header">

                        Latest Shayari

                    </div>

                    <ul class="list-group list-group-flush">

                        <% latestShayari.forEach(item=>{ %>

                            <li class="list-group-item d-flex justify-content-between">

                                <span>

                                    <%= item.title %>

                                </span>

                                <a
                                    href="/admin/shayari/<%= item._id %>/edit">

                                    Edit

                                </a>

                            </li>

                        <% }) %>

                    </ul>

                </div>

            </div>

            <div class="col-lg-6">

                <div class="card shadow-sm mb-4">

                    <div class="card-header">

                        Latest Users

                    </div>

                    <ul class="list-group list-group-flush">

                        <% latestUsers.forEach(item=>{ %>

                            <li class="list-group-item d-flex justify-content-between">

                                <span>

                                    <%= item.name %>

                                </span>

                                <small>

                                    <%= item.email %>

                                </small>

                            </li>

                        <% }) %>

                    </ul>

                </div>

            </div>

        </div>

        <!-- Quick Actions -->

        <div class="card shadow-sm mb-4">

            <div class="card-header">

                Quick Actions

            </div>

            <div class="card-body d-flex flex-wrap gap-2">

                <a
                    href="/admin/shayari/new"
                    class="btn btn-primary">

                    Add Shayari

                </a>

                <a
                    href="/admin/categories"
                    class="btn btn-success">

                    Categories

                </a>

                <a
                    href="/admin/users"
                    class="btn btn-warning">

                    Users

                </a>

                <a
                    href="/admin/settings"
                    class="btn btn-dark">

                    Settings

                </a>

            </div>

        </div>

        <!-- System Status -->

        <div class="card shadow-sm">

            <div class="card-header">

                System Status

            </div>

            <div class="card-body">

                <div class="row">

                    <div class="col-md-3">

                        Database

                        <span class="badge bg-success">

                            Connected

                        </span>

                    </div>

                    <div class="col-md-3">

                        Server

                        <span class="badge bg-success">

                            Running

                        </span>

                    </div>

                    <div class="col-md-3">

                        Storage

                        <span class="badge bg-success">

                            OK

                        </span>

                    </div>

                    <div class="col-md-3">

                        Email

                        <span class="badge bg-success">

                            Active

                        </span>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>

<script>

new Chart(
    document.getElementById("trafficChart"),
    {
        type: "line",
        data: trafficChartData
    }
);

new Chart(
    document.getElementById("categoryChart"),
    {
        type: "doughnut",
        data: categoryChartData
    }
);

</script>
