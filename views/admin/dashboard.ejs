                    </div>

                </div>

            </div>

            <div class="col-lg-3 col-md-6">

                <div class="card shadow-sm">

                    <div class="card-body text-center">

                        <i class="fa-solid fa-users fa-2x text-success mb-2"></i>

                        <h3>

                            <%= stats.users %>

                        </h3>

                        <p class="mb-0">

                            Users

                        </p>

                    </div>

                </div>

            </div>

            <div class="col-lg-3 col-md-6">

                <div class="card shadow-sm">

                    <div class="card-body text-center">

                        <i class="fa-solid fa-comments fa-2x text-warning mb-2"></i>

                        <h3>

                            <%= stats.comments %>

                        </h3>

                        <p class="mb-0">

                            Comments

                        </p>

                    </div>

                </div>

            </div>

            <div class="col-lg-3 col-md-6">

                <div class="card shadow-sm">

                    <div class="card-body text-center">

                        <i class="fa-solid fa-image fa-2x text-danger mb-2"></i>

                        <h3>

