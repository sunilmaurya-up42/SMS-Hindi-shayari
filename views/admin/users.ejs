<section class="py-4">

    <div class="container-fluid">

        <!-- Header -->

        <div class="d-flex justify-content-between align-items-center flex-wrap mb-4">

            <div>

                <h2 class="fw-bold">

                    User Management

                </h2>

                <p class="text-muted mb-0">

                    Manage registered users.

                </p>

            </div>

            <a
                href="/admin/users/create"
                class="btn btn-primary">

                <i class="fa-solid fa-user-plus"></i>

                Add User

            </a>

        </div>

        <!-- Search & Filters -->

        <div class="card shadow-sm mb-4">

            <div class="card-body">

                <form
                    action="/admin/users"
                    method="GET">

                    <div class="row g-3">

                        <div class="col-lg-4">

                            <input
                                type="text"
                                name="q"
                                value="<%= query || '' %>"
                                class="form-control"
                                placeholder="Search users...">

                        </div>

                        <div class="col-lg-3">

                            <select
                                name="role"
                                class="form-select">

                                <option value="">

                                    All Roles

                                </option>

                                <option
                                    value="admin"
                                    <%= role==="admin"?"selected":"" %>>

                                    Admin

                                </option>

                                <option
                                    value="user"
                                    <%= role==="user"?"selected":"" %>>

                                    User

                                </option>

                            </select>

                        </div>

                        <div class="col-lg-3">

                            <select
                                name="status"
                                class="form-select">

                                <option value="">

                                    All Status

                                </option>

                                <option
                                    value="active"
                                    <%= status==="active"?"selected":"" %>>

                                    Active

                                </option>

                                <option
                                    value="banned"
                                    <%= status==="banned"?"selected":"" %>>

                                    Banned

                                </option>

                            </select>

                        </div>

                        <div class="col-lg-2">

                            <button
                                class="btn btn-primary w-100">

                                Search

                            </button>

                        </div>

                    </div>

                </form>

            </div>

        </div>

        <!-- Users Table -->

        <form
            action="/admin/users/bulk"
            method="POST">

            <input
                type="hidden"
                name="_csrf"
                value="<%= csrfToken %>">

            <div class="card shadow-sm">

                <div class="card-header d-flex justify-content-between align-items-center flex-wrap">

                    <div>

                        <select
                            name="action"
                            class="form-select">

                            <option value="">

                                Bulk Action

                            </option>

                            <option value="activate">

                                Activate

                            </option>

                            <option value="ban">

                                Ban

                            </option>

                            <option value="delete">

                                Delete

                            </option>

                        </select>

                    </div>

                    <div class="mt-2 mt-md-0">

                        <button
                            class="btn btn-warning">

                            Apply

                        </button>

                        <a
                            href="/admin/users/export/csv"
                            class="btn btn-success">

                            CSV

                        </a>

                        <a
                            href="/admin/users/export/excel"
                            class="btn btn-info">

                            Excel

                        </a>

                    </div>

                </div>

                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">

                            <tr>

                                <th>

                                    <input
                                        type="checkbox"
                                        id="selectAll">

                                </th>

                                <th>User</th>

                                <th>Email</th>

                                <th>Role</th>

                                <th>Status</th>

                                <th>Joined</th>

                                <th>Actions</th>

                            </tr>

                        </thead>

                        <tbody>

                            <% if(users.length){ %>

                                <% users.forEach(user=>{ %>

                                    <tr>

                                        <td>

                                            <input
                                                type="checkbox"
                                                name="ids"
                                                value="<%= user._id %>">

                                        </td>

                                        <td>

                                            <div class="d-flex align-items-center">

                                                <img
                                                    src="<%= user.avatar || '/images/default-avatar.png' %>"
                                                    class="rounded-circle me-2"
                                                    style="width:40px;height:40px;object-fit:cover;">

                                                <%= user.name %>

                                            </div>

                                        </td>

                                        <td>

                                            <%= user.email %>

                                        </td>

                                        <td>

                                            <span class="badge bg-primary">

                                                <%= user.role %>

                                            </span>

                                        </td>

                                        <td>

                                            <% if(user.status==="active"){ %>

                                                <span class="badge bg-success">

                                                    Active

                                                </span>

                                            <% } else { %>

                                                <span class="badge bg-danger">

                                                    Banned

                                                </span>

                                            <% } %>

                                        </td>

                                        <td>

                                            <%= new Date(user.createdAt).toLocaleDateString() %>

                                        </td>

                                        <td>

                                            <div class="dropdown">

                                                <button
                                                    class="btn btn-sm btn-outline-secondary dropdown-toggle"
                                                    data-bs-toggle="dropdown">

                                                    Actions

                                                </button>

                                                <ul class="dropdown-menu">

                                                    <li>

                                                        <a
                                                            class="dropdown-item"
                                                            href="/profile/<%= user._id %>">

                                                            View Profile

                                                        </a>

                                                    </li>

                                                    <li>

                                                        <a
                                                            class="dropdown-item"
                                                            href="/admin/users/<%= user._id %>/edit">

                                                            Edit

                                                        </a>

                                                    </li>

                                                    <li>

                                                        <form
                                                            action="/admin/users/<%= user._id %>/toggle-status"
                                                            method="POST">

                                                            <input
                                                                type="hidden"
                                                                name="_csrf"
                                                                value="<%= csrfToken %>">

                                                            <button
                                                                class="dropdown-item">

                                                                <%= user.status==="active" ? "Ban User" : "Activate User" %>

                                                            </button>

                                                        </form>

                                                    </li>

                                                    <li>

                                                        <form
                                                            action="/admin/users/<%= user._id %>?_method=DELETE"
                                                            method="POST">

                                                            <input
                                                                type="hidden"
                                                                name="_csrf"
                                                                value="<%= csrfToken %>">

                                                            <button
                                                                class="dropdown-item text-danger"
                                                                onclick="return confirm('Delete this user?')">

                                                                Delete

                                                            </button>

                                                        </form>

                                                    </li>

                                                </ul>

                                            </div>

                                        </td>

                                    </tr>

                                <% }) %>

                            <% } else { %>

                                <tr>

                                    <td
                                        colspan="7"
                                        class="text-center py-4">

                                        No users found.

                                    </td>

                                </tr>

                            <% } %>

                        </tbody>

                    </table>

                </div>

            </div>

        </form>

        <!-- Pagination -->

        <% if(pagination && pagination.totalPages>1){ %>

            <nav class="mt-4">

                <ul class="pagination justify-content-center">

                    <% for(let i=1;i<=pagination.totalPages;i++){ %>

                        <li class="page-item <%= pagination.page===i?'active':'' %>">

                            <a
                                class="page-link"
                                href="?page=<%= i %>">

                                <%= i %>

                            </a>

                        </li>

                    <% } %>

                </ul>

            </nav>

        <% } %>

    </div>

</section>

<script>

document
.getElementById("selectAll")
?.addEventListener("change", function(){

    document
    .querySelectorAll("input[name='ids']")
    .forEach(item => {

        item.checked = this.checked;

    });

});

</script>
