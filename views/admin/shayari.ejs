<section class="py-4">

    <div class="container-fluid">

        <!-- Header -->

        <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap">

            <div>

                <h2 class="fw-bold">

                    Shayari Management

                </h2>

                <p class="text-muted mb-0">

                    Manage all Shayari from one place.

                </p>

            </div>

            <a
                href="/admin/shayari/new"
                class="btn btn-primary">

                <i class="fa-solid fa-plus"></i>

                Add Shayari

            </a>

        </div>

        <!-- Filters -->

        <div class="card shadow-sm mb-4">

            <div class="card-body">

                <form
                    action="/admin/shayari"
                    method="GET">

                    <div class="row g-3">

                        <div class="col-lg-4">

                            <input
                                type="text"
                                name="q"
                                value="<%= query || '' %>"
                                class="form-control"
                                placeholder="Search title or content">

                        </div>

                        <div class="col-lg-3">

                            <select
                                name="category"
                                class="form-select">

                                <option value="">

                                    All Categories

                                </option>

                                <% categories.forEach(category=>{ %>

                                    <option
                                        value="<%= category._id %>"
                                        <%= selectedCategory==category._id ? "selected" : "" %>>

                                        <%= category.name %>

                                    </option>

                                <% }) %>

                            </select>

                        </div>

                        <div class="col-lg-3">

                            <select
                                name="status"
                                class="form-select">

                                <option value="">

                                    All Status

                                </option>

                                <option
                                    value="published"
                                    <%= selectedStatus==="published"?"selected":"" %>>

                                    Published

                                </option>

                                <option
                                    value="draft"
                                    <%= selectedStatus==="draft"?"selected":"" %>>

                                    Draft

                                </option>

                            </select>

                        </div>

                        <div class="col-lg-2">

                            <button
                                class="btn btn-primary w-100">

                                Search

                            </button>

                        </div>

                    </div>

                </form>

            </div>

        </div>

        <!-- Bulk Actions -->

        <form
            action="/admin/shayari/bulk"
            method="POST">

            <input
                type="hidden"
                name="_csrf"
                value="<%= csrfToken %>">

            <div class="card shadow-sm">

                <div class="card-header d-flex justify-content-between align-items-center flex-wrap">

                    <div>

                        <select
                            name="action"
                            class="form-select">

                            <option value="">

                                Bulk Action

                            </option>

                            <option value="publish">

                                Publish

                            </option>

                            <option value="draft">

                                Move to Draft

                            </option>

                            <option value="delete">

                                Delete

                            </option>

                        </select>

                    </div>

                    <div class="mt-2 mt-md-0">

                        <button
                            class="btn btn-warning">

                            Apply

                        </button>

                        <a
                            href="/admin/shayari/export/csv"
                            class="btn btn-success">

                            CSV

                        </a>

                        <a
                            href="/admin/shayari/export/excel"
                            class="btn btn-info">

                            Excel

                        </a>

                    </div>

                </div>

                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">

                            <tr>

                                <th>

                                    <input
                                        type="checkbox"
                                        id="selectAll">

                                </th>

                                <th>Title</th>

                                <th>Category</th>

                                <th>Status</th>

                                <th>Views</th>

                                <th>Likes</th>

                                <th>Date</th>

                                <th>Actions</th>

                            </tr>

                        </thead>

                        <tbody>

                            <% if(shayari.length){ %>

                                <% shayari.forEach(item=>{ %>

                                    <tr>

                                        <td>

                                            <input
                                                type="checkbox"
                                                name="ids"
                                                value="<%= item._id %>">

                                        </td>

                                        <td>

                                            <%= item.title %>

                                        </td>

                                        <td>

                                            <%= item.category?.name || "-" %>

                                        </td>

                                        <td>

                                            <% if(item.status==="published"){ %>

                                                <span class="badge bg-success">

                                                    Published

                                                </span>

                                            <% }else{ %>

                                                <span class="badge bg-secondary">

                                                    Draft

                                                </span>

                                            <% } %>

                                        </td>

                                        <td>

                                            <%= item.views || 0 %>

                                        </td>

                                        <td>

                                            <%= item.likes || 0 %>

                                        </td>

                                        <td>

                                            <%= new Date(item.createdAt).toLocaleDateString() %>

                                        </td>

                                        <td>

                                            <div class="dropdown">

                                                <button
                                                    class="btn btn-sm btn-outline-secondary dropdown-toggle"
                                                    data-bs-toggle="dropdown">

                                                    Action

                                                </button>

                                                <ul class="dropdown-menu">

                                                    <li>

                                                        <a
                                                            class="dropdown-item"
                                                            href="/shayari/<%= item.slug %>">

                                                            View

                                                        </a>

                                                    </li>

                                                    <li>

                                                        <a
                                                            class="dropdown-item"
                                                            href="/admin/shayari/<%= item._id %>/edit">

                                                            Edit

                                                        </a>

                                                    </li>

                                                    <li>

                                                        <form
                                                            action="/admin/shayari/<%= item._id %>?_method=DELETE"
                                                            method="POST">

                                                            <input
                                                                type="hidden"
                                                                name="_csrf"
                                                                value="<%= csrfToken %>">

                                                            <button
                                                                class="dropdown-item text-danger"
                                                                onclick="return confirm('Delete this Shayari?')">

                                                                Delete

                                                            </button>

                                                        </form>

                                                    </li>

                                                </ul>

                                            </div>

                                        </td>

                                    </tr>

                                <% }) %>

                            <% }else{ %>

                                <tr>

                                    <td
                                        colspan="8"
                                        class="text-center py-4">

                                        No Shayari Found.

                                    </td>

                                </tr>

                            <% } %>

                        </tbody>

                    </table>

                </div>

            </div>

        </form>

        <!-- Pagination -->

        <% if(pagination && pagination.totalPages>1){ %>

            <nav class="mt-4">

                <ul class="pagination justify-content-center">

                    <% for(let i=1;i<=pagination.totalPages;i++){ %>

                        <li class="page-item <%= pagination.page===i?'active':'' %>">

                            <a
                                class="page-link"
                                href="?page=<%= i %>">

                                <%= i %>

                            </a>

                        </li>

                    <% } %>

                </ul>

            </nav>

        <% } %>

    </div>

</section>

<script>

document
.getElementById("selectAll")
?.addEventListener("change", function(){

    document
    .querySelectorAll("input[name='ids']")
    .forEach(item => {

        item.checked = this.checked;

    });

});

</script>
