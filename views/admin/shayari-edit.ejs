<section class="py-4">

    <div class="container">

        <!-- Header -->

        <div class="d-flex justify-content-between align-items-center mb-4">

            <div>

                <h2 class="fw-bold">
                    Edit Shayari
                </h2>

                <p class="text-muted mb-0">
                    Update Shayari information
                </p>

            </div>

            <a
                href="/admin/dashboard"
                class="btn btn-secondary">

                ← Dashboard

            </a>

        </div>


        <!-- Edit Shayari Card -->

        <div class="card shadow-sm">

            <div class="card-header">

                <strong>
                    Shayari Information
                </strong>

            </div>


            <div class="card-body">

                <form
                    method="POST"
                    action="/admin/shayari/<%= shayari._id %>/edit">

                    <!-- CSRF -->

                    <input
                        type="hidden"
                        name="_csrf"
                        value="<%= csrfToken %>">


                    <!-- Title -->

                    <div class="mb-3">

                        <label
                            for="title"
                            class="form-label">

                            Title

                        </label>

                        <input
                            type="text"
                            id="title"
                            name="title"
                            class="form-control"
                            value="<%= shayari.title || '' %>"
                            maxlength="200"
                            required>

                    </div>


                    <!-- Shayari -->

                    <div class="mb-3">

                        <label
                            for="content"
                            class="form-label">

                            Shayari

                        </label>

                        <textarea
                            id="content"
                            name="content"
                            class="form-control"
                            rows="8"
                            required><%= shayari.content || '' %></textarea>

                    </div>


                    <!-- Category -->

                    <div class="mb-3">

                        <label
                            for="category"
                            class="form-label">

                            Category

                        </label>

                        <select
                            id="category"
                            name="category"
                            class="form-select"
                            required>

                            <option value="">
                                Select Category
                            </option>

                            <% categories.forEach(category => { %>

                                <option
                                    value="<%= category._id %>"
                                    <%= String(shayari.category) === String(category._id) ? "selected" : "" %>>

                                    <%= category.name %>

                                </option>

                            <% }) %>

                        </select>

                    </div>


                    <!-- Published -->

                    <div class="mb-3">

                        <label
                            for="published"
                            class="form-label">

                            Status

                        </label>

                        <select
                            id="published"
                            name="published"
                            class="form-select">

                            <option
                                value="true"
                                <%= shayari.published !== false ? "selected" : "" %>>

                                Published

                            </option>

                            <option
                                value="false"
                                <%= shayari.published === false ? "selected" : "" %>>

                                Draft

                            </option>

                        </select>

                    </div>


                    <!-- Featured -->

                    <div class="form-check mb-3">

                        <input
                            class="form-check-input"
                            type="checkbox"
                            id="featured"
                            name="featured"
                            value="true"
                            <%= shayari.featured ? "checked" : "" %>>

                        <label
                            class="form-check-label"
                            for="featured">

                            Featured Shayari

                        </label>

                    </div>


                    <!-- Trending -->

                    <div class="form-check mb-4">

                        <input
                            class="form-check-input"
                            type="checkbox"
                            id="trending"
                            name="trending"
                            value="true"
                            <%= shayari.trending ? "checked" : "" %>>

                        <label
                            class="form-check-label"
                            for="trending">

                            Trending Shayari

                        </label>

                    </div>


                    <!-- Buttons -->

                    <div class="d-flex gap-2 flex-wrap">

                        <button
                            type="submit"
                            class="btn btn-primary">

                            <i class="fa-solid fa-save me-1"></i>

                            Update Shayari

                        </button>


                        <a
                            href="/admin/dashboard"
                            class="btn btn-secondary">

                            Cancel

                        </a>

                    </div>

                </form>

            </div>

        </div>

    </div>

</section>
