<section class="py-4">

    <div class="container-fluid">

        <!-- Header -->

        <div class="d-flex justify-content-between align-items-center flex-wrap mb-4">

            <div>

                <h2 class="fw-bold">

                    Comment Management

                </h2>

                <p class="text-muted mb-0">

                    Manage all website comments.

                </p>

            </div>

        </div>

        <!-- Search & Filter -->

        <div class="card shadow-sm mb-4">

            <div class="card-body">

                <form
                    action="/admin/comments"
                    method="GET">

                    <div class="row g-3">

                        <div class="col-lg-6">

                            <input
                                type="text"
                                name="q"
                                value="<%= query || '' %>"
                                class="form-control"
                                placeholder="Search comments...">

                        </div>

                        <div class="col-lg-4">

                            <select
                                name="status"
                                class="form-select">

                                <option value="">

                                    All Status

                                </option>

                                <option value="approved">

                                    Approved

                                </option>

                                <option value="pending">

                                    Pending

                                </option>

                                <option value="spam">

                                    Spam

                                </option>

                            </select>

                        </div>

                        <div class="col-lg-2">

                            <button
                                class="btn btn-primary w-100">

                                Search

                            </button>

                        </div>

                    </div>

                </form>

            </div>

        </div>

        <!-- Bulk Actions -->

        <form
            action="/admin/comments/bulk"
            method="POST">

            <input
                type="hidden"
                name="_csrf"
                value="<%= csrfToken %>">

            <div class="card shadow-sm">

                <div class="card-header d-flex justify-content-between flex-wrap">

                    <div>

                        <select
                            name="action"
                            class="form-select">

                            <option value="">

                                Bulk Action

                            </option>

                            <option value="approve">

                                Approve

                            </option>

                            <option value="reject">

                                Reject

                            </option>

                            <option value="spam">

                                Mark as Spam

                            </option>

                            <option value="delete">

                                Delete

                            </option>

                        </select>

                    </div>

                    <div class="mt-2 mt-md-0">

                        <button class="btn btn-warning">

                            Apply

                        </button>

                        <a
                            href="/admin/comments/export/csv"
                            class="btn btn-success">

                            CSV

                        </a>

                        <a
                            href="/admin/comments/export/excel"
                            class="btn btn-info">

                            Excel

                        </a>

                    </div>

                </div>

                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">

                            <tr>

                                <th>

                                    <input
                                        type="checkbox"
                                        id="selectAll">

                                </th>

                                <th>User</th>

                                <th>Shayari</th>

                                <th>Comment</th>

                                <th>Status</th>

                                <th>Date</th>

                                <th>Actions</th>

                            </tr>

                        </thead>

                        <tbody>

                            <% if(comments.length){ %>

                                <% comments.forEach(comment=>{ %>

                                    <tr>

                                        <td>

                                            <input
                                                type="checkbox"
                                                name="ids"
                                                value="<%= comment._id %>">

                                        </td>

                                        <td>

                                            <strong>

                                                <%= comment.user?.name || "Guest" %>

                                            </strong>

                                            <br>

                                            <small>

                                                <%= comment.user?.email || "" %>

                                            </small>

                                        </td>

                                        <td>

                                            <a
                                                href="/shayari/<%= comment.shayari?.slug %>"
                                                target="_blank">

                                                <%= comment.shayari?.title %>

                                            </a>

                                        </td>

                                        <td style="max-width:300px;">

                                            <%= comment.content %>

                                        </td>

                                        <td>

                                            <% if(comment.status==="approved"){ %>

                                                <span class="badge bg-success">

                                                    Approved

                                                </span>

                                            <% }else if(comment.status==="pending"){ %>

                                                <span class="badge bg-warning text-dark">

                                                    Pending

                                                </span>

                                            <% }else{ %>

                                                <span class="badge bg-danger">

                                                    Spam

                                                </span>

                                            <% } %>

                                        </td>

                                        <td>

                                            <%= new Date(comment.createdAt).toLocaleDateString() %>

                                        </td>

                                        <td>

                                            <div class="dropdown">

                                                <button
                                                    class="btn btn-outline-secondary btn-sm dropdown-toggle"
                                                    data-bs-toggle="dropdown">

                                                    Actions

                                                </button>

                                                <ul class="dropdown-menu">

                                                    <li>

                                                        <a
                                                            class="dropdown-item"
                                                            href="/admin/comments/<%= comment._id %>/reply">

                                                            Reply

                                                        </a>

                                                    </li>

                                                    <li>

                                                        <form 
                                                            method="POST"
                                                            action="/admin/comments/<%= comment._id %>/approve">
                                                            <input
                                                                type="hidden"
                                                                name="_csrf"
                                                                value="<%= csrfToken %>">

                                                            <button type="submit" class="dropdown-item">

                                                                Approve

                                                            </button>

                                                        </form>

                                                    </li>

                                                    <li>

                                                        <form
                                                            action="/admin/comments/<%= comment._id %>/reject"
                                                            method="POST">

                                                            <input
                                                                type="hidden"
                                                                name="_csrf"
                                                                value="<%= csrfToken %>">

                                                            <button type="submit" class="dropdown-item">

                                                                Reject

                                                            </button>

                                                        </form>

                                                    </li>

                                                    <li>

                                                        <form
                                                            action="/admin/comments/<%= comment._id %>/delete"
                                                            method="POST">

                                                            <input
                                                                type="hidden"
                                                                name="_csrf"
                                                                value="<%= csrfToken %>">

                                                            <button
                                                                class="dropdown-item text-danger"
                                                                onclick="return confirm('Delete this comment?')">

                                                                Delete

                                                            </button>

                                                        </form>

                                                    </li>

                                                </ul>

                                            </div>

                                        </td>

                                    </tr>

                                <% }) %>

                            <% }else{ %>

                                <tr>

                                    <td
                                        colspan="7"
                                        class="text-center py-4">

                                        No comments found.

                                    </td>

                                </tr>

                            <% } %>

                        </tbody>

                    </table>

                </div>

            </div>

        </form>

        <!-- Pagination -->

        <% if(pagination && pagination.totalPages>1){ %>

            <nav class="mt-4">

                <ul class="pagination justify-content-center">

                    <% for(let i=1;i<=pagination.totalPages;i++){ %>

                        <li class="page-item <%= pagination.page===i?'active':'' %>">

                            <a
                                class="page-link"
                                href="?page=<%= i %>">

                                <%= i %>

                            </a>

                        </li>

                    <% } %>

                </ul>

            </nav>

        <% } %>

    </div>

</section>

<script>

document
.getElementById("selectAll")
?.addEventListener("change", function(){

    document
    .querySelectorAll("input[name='ids']")
    .forEach(item => {

        item.checked = this.checked;

    });

});

</script>
