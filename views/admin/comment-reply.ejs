<!DOCTYPE html>
<html lang="hi">
<head>
    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title><%= title || "Reply to Comment" %></title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            padding: 20px;
            font-family: Arial, sans-serif;
            background: #f5f6f8;
            color: #222;
        }

        .container {
            max-width: 700px;
            margin: 30px auto;
        }

        .card {
            background: #fff;
            border: 1px solid #ddd;
            border-radius: 10px;
            padding: 24px;
            box-shadow: 0 2px 8px rgba(0,0,0,.08);
        }

        h1 {
            margin-top: 0;
            font-size: 25px;
        }

        .comment-box {
            background: #f8f9fa;
            border: 1px solid #ddd;
            border-radius: 8px;
            padding: 15px;
            margin: 20px 0;
        }

        .name {
            font-weight: 700;
            margin-bottom: 8px;
        }

        .message {
            white-space: pre-wrap;
            line-height: 1.6;
        }

        label {
            display: block;
            font-weight: 600;
            margin-bottom: 8px;
        }

        textarea {
            width: 100%;
            min-height: 160px;
            padding: 12px;
            border: 1px solid #ccc;
            border-radius: 8px;
            resize: vertical;
            font-size: 16px;
            font-family: inherit;
        }

        .buttons {
            display: flex;
            gap: 10px;
            margin-top: 18px;
        }

        button,
        .back {
            border: 0;
            border-radius: 7px;
            padding: 11px 18px;
            font-size: 15px;
            cursor: pointer;
            text-decoration: none;
        }

        .reply {
            background: #1677ff;
            color: #fff;
        }

        .back {
            background: #eee;
            color: #222;
        }

        @media (max-width: 600px) {
            body {
                padding: 10px;
            }

            .container {
                margin: 10px auto;
            }

            .card {
                padding: 18px;
            }

            .buttons {
                flex-direction: column;
            }

            button,
            .back {
                width: 100%;
                text-align: center;
            }
        }
    </style>
</head>

<body>

<div class="container">

    <div class="card">

        <h1>Reply to Comment</h1>

        <div class="comment-box">

            <div class="name">
                <%= comment.name || "Guest" %>
            </div>

            <div class="message">
                <%= comment.message || "" %>
            </div>

        </div>

        <form
            method="POST"
            action="/admin/comments/<%= comment._id %>/reply"
        >

            <input
                type="hidden"
                name="_csrf"
                value="<%= csrfToken %>"
            >

            <label for="reply">
                Your Reply
            </label>

            <textarea
                id="reply"
                name="reply"
                placeholder="Write your reply..."
                required
            ></textarea>

            <div class="buttons">

                <button
                    type="submit"
                    class="reply"
                >
                    Send Reply
                </button>

                <a
                    href="/admin/comments"
                    class="back"
                >
                    Back
                </a>

            </div>

        </form>

    </div>

</div>

</body>
</html>
