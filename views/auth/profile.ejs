<section class="py-5">

    <div class="container">

        <div class="row">

            <!-- Sidebar -->

            <div class="col-lg-4 mb-4">

                <div class="card shadow-sm">

                    <div class="card-body text-center">

                        <img
                            src="<%= user.avatar || '/images/default-avatar.png' %>"
                            class="rounded-circle img-thumbnail mb-3"
                            alt="Profile"
                            style="width:150px;height:150px;object-fit:cover;">

                        <h3>

                            <%= user.name %>

                        </h3>

                        <p class="text-muted">

                            <%= user.email %>

                        </p>

                        <% if(user.emailVerified){ %>

                            <span class="badge bg-success">

                                <i class="fa-solid fa-circle-check"></i>

                                Verified

                            </span>

                        <% }else{ %>

                            <span class="badge bg-warning text-dark">

                                Pending Verification

                            </span>

                        <% } %>

                        <hr>

                        <p>

                            <strong>Joined:</strong>

                            <%= new Date(user.createdAt).toLocaleDateString() %>

                        </p>

                        <form
                            action="/profile/avatar"
                            method="POST"
                            enctype="multipart/form-data">

                            <input
                                type="hidden"
                                name="_csrf"
                                value="<%= csrfToken %>">

                            <input
                                type="file"
                                name="avatar"
                                class="form-control mb-3"
                                accept="image/*">

                            <button
                                class="btn btn-primary w-100">

                                Change Photo

                            </button>

                        </form>

                    </div>

                </div>

            </div>

            <!-- Main -->

            <div class="col-lg-8">

                <!-- Edit Profile -->

                <div class="card shadow-sm mb-4">

                    <div class="card-header">

                        <h4 class="mb-0">

                            Edit Profile

                        </h4>

                    </div>

                    <div class="card-body">

                        <form
                            action="/profile"
                            method="POST">

                            <input
                                type="hidden"
                                name="_csrf"
                                value="<%= csrfToken %>">

                            <div class="mb-3">

                                <label class="form-label">

                                    Full Name

                                </label>

                                <input
                                    type="text"
                                    name="name"
                                    class="form-control"
                                    value="<%= user.name %>">

                            </div>

                            <div class="mb-3">

                                <label class="form-label">

                                    Bio

                                </label>

                                <textarea
                                    name="bio"
                                    rows="4"
                                    class="form-control"><%= user.bio || '' %></textarea>

                            </div>

                            <div class="row">

                                <div class="col-md-4">

                                    <label class="form-label">

                                        Facebook

                                    </label>

                                    <input
                                        type="url"
                                        name="facebook"
                                        class="form-control"
                                        value="<%= user.social?.facebook || '' %>">

                                </div>

                                <div class="col-md-4">

                                    <label class="form-label">

                                        Instagram

                                    </label>

                                    <input
                                        type="url"
                                        name="instagram"
                                        class="form-control"
                                        value="<%= user.social?.instagram || '' %>">

                                </div>

                                <div class="col-md-4">

                                    <label class="form-label">

                                        Website

                                    </label>

                                    <input
                                        type="url"
                                        name="website"
                                        class="form-control"
                                        value="<%= user.social?.website || '' %>">

                                </div>

                            </div>

                            <button
                                class="btn btn-success mt-4">

                                Save Changes

                            </button>

                        </form>

                    </div>

                </div>

                <!-- Statistics -->

                <div class="row mb-4">

                    <div class="col-md-3">

                        <div class="card text-center shadow-sm">

                            <div class="card-body">

                                <h3>

                                    <%= stats.posts || 0 %>

                                </h3>

                                Posts

                            </div>

                        </div>

                    </div>

                    <div class="col-md-3">

                        <div class="card text-center shadow-sm">

                            <div class="card-body">

                                <h3>

                                    <%= stats.likes || 0 %>

                                </h3>

                                Likes

                            </div>

                        </div>

                    </div>

                    <div class="col-md-3">

                        <div class="card text-center shadow-sm">

                            <div class="card-body">

                                <h3>

                                    <%= stats.bookmarks || 0 %>

                                </h3>

                                Bookmarks

                            </div>

                        </div>

                    </div>

                    <div class="col-md-3">

                        <div class="card text-center shadow-sm">

                            <div class="card-body">

                                <h3>

                                    <%= stats.comments || 0 %>

                                </h3>

                                Comments

                            </div>

                        </div>

                    </div>

                </div>

                <!-- Change Password -->

                <div class="card shadow-sm mb-4">

                    <div class="card-header">

                        Change Password

                    </div>

                    <div class="card-body">

                        <form
                            action="/profile/change-password"
                            method="POST">

                            <input
                                type="hidden"
                                name="_csrf"
                                value="<%= csrfToken %>">

                            <input
                                type="password"
                                name="currentPassword"
                                class="form-control mb-3"
                                placeholder="Current Password"
                                required>

                            <input
                                type="password"
                                name="newPassword"
                                class="form-control mb-3"
                                placeholder="New Password"
                                required>

                            <button
                                class="btn btn-warning">

                                Update Password

                            </button>

                        </form>

                    </div>

                </div>

                <!-- Danger Zone -->

                <div class="card border-danger shadow-sm">

                    <div class="card-header bg-danger text-white">

                        Danger Zone

                    </div>

                    <div class="card-body">

                        <p>

                            Deleting your account is permanent.

                        </p>

                        <form
                            action="/profile/delete"
                            method="POST"
                            onsubmit="return confirm('Delete your account permanently?');">

                            <input
                                type="hidden"
                                name="_csrf"
                                value="<%= csrfToken %>">

                            <button
                                class="btn btn-danger">

                                Delete Account

                            </button>

                        </form>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>
