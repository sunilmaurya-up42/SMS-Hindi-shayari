
<section class="py-5">

    <div class="container">

        <!-- Breadcrumb -->
        <nav aria-label="breadcrumb" class="mb-4">

            <ol class="breadcrumb">

                <li class="breadcrumb-item">

                    <a href="/">Home</a>

                </li>

                <li class="breadcrumb-item">

                    <a href="/category/<%= shayari.category?.slug %>">

                        <%= shayari.category?.name %>

                    </a>

                </li>

                <li
                    class="breadcrumb-item active"
                    aria-current="page">

                    <%= shayari.title %>

                </li>

            </ol>

        </nav>

        <div class="row">

            <!-- Main Content -->
            <div class="col-lg-8">

                <div class="card shadow-sm">

                    <% if (shayari.imageUrl) { %>

                        <img
                            src="<%= shayari.imageUrl %>"
                            alt="<%= shayari.title %>"
                            class="card-img-top">

                    <% } %>

                    <div class="card-body">

                        <span class="badge bg-primary mb-3">

                            <%= shayari.category?.name || "General" %>

                        </span>

                        <h1 class="mb-3">

                            <%= shayari.title %>

                        </h1>

                        <pre
                            id="shayariText"
                            class="fs-5 border rounded p-3 bg-light"
                            style="white-space: pre-wrap;font-family:inherit;"><%= shayari.content %></pre>

                        <div class="row text-center my-4">

                            <div class="col">

                                <i class="fa-solid fa-eye"></i>

                                <br>

                                <strong>

                                    <%= shayari.views || 0 %>

                                </strong>

                            </div>

                            <div class="col">

                                <i class="fa-solid fa-heart text-danger"></i>

                                <br>

                                <strong id="likeCount">

                                    <%= shayari.likes || 0 %>

                                </strong>

                            </div>

                            <div class="col">

                                <i class="fa-solid fa-share-nodes text-success"></i>

                                <br>

                                <strong>

                                    <%= shayari.shares || 0 %>

                                </strong>

                            </div>

                        </div>

                        <div class="d-grid gap-2 d-md-flex">

                            <button
                                id="copyBtn"
                                class="btn btn-outline-primary">

                                <i class="fa-solid fa-copy"></i>

                                Copy

                            </button>

                            <button
                                class="btn btn-outline-danger"
                                id="likeBtn"
                                data-id="<%= shayari._id %>">

                                <i class="fa-solid fa-heart"></i>

                                Like

                            </button>

                            <button
                                id="shareBtn"
                                class="btn btn-outline-success">

                                <i class="fa-solid fa-share-nodes"></i>

                                Share

                            </button>

                            <a
    href="/shayari/download-image/<%= shayari._id %>"
    class="btn btn-success">

    <i class="fa-solid fa-download"></i>

    Download

</a>
                            <button
                                class="btn btn-warning"
                                id="bookmarkBtn">

                                <i class="fa-solid fa-bookmark"></i>

                                Bookmark

                            </button>

                        </div>

                    </div>

                </div>

                <!-- Comments -->

                <div class="card shadow-sm mt-4">

                    <div class="card-header">

                        <h4 class="mb-0">

                            Comments

                        </h4>

                    </div>

                    <div class="card-body">

                        <% if(user){ %>

                            <form
    action="/comments"
    method="POST">

    <!-- CSRF TOKEN -->
    <input
        type="hidden"
        name="_csrf"
        value="<%= csrfToken %>">

    <!-- SHAYARI ID -->
    <input
        type="hidden"
        name="shayari"
        value="<%= shayari._id %>">

    <!-- USER NAME -->
    <input
        type="hidden"
        name="name"
        value="<%= user.name || "" %>">

    <!-- USER EMAIL -->
    <input
        type="hidden"
        name="email"
        value="<%= user.email || "" %>">

    <textarea
        class="form-control mb-3"
        name="comment"
        rows="4"
        placeholder="Write your comment..."
        required></textarea>

    <button
        type="submit"
        class="btn btn-primary">

        Post Comment

    </button>

</form>

                        <% } else { %>

                            <div class="alert alert-info">

                                Please login to comment.

                            </div>

                        <% } %>

                        <hr>

                        <% if(comments && comments.length){ %>

                            <% comments.forEach(comment=>{ %>

                                <div class="border rounded p-3 mb-3">

                                    <strong>

                                        <%= comment.user.name %>

                                    </strong>

                                    <small class="text-muted ms-2">

                                        <%= new Date(comment.createdAt).toLocaleString() %>

                                    </small>

                                    <p class="mt-2 mb-0">

                                        <%= comment.comment %>

                                    </p>

                                </div>

                            <% }) %>

                        <% } else { %>

                            <p class="text-muted">

                                No comments yet.

                            </p>

                        <% } %>

                    </div>

                </div>

            </div>

            <!-- Sidebar -->

            <div class="col-lg-4">

                <div class="card shadow-sm">

                    <div class="card-header">

                        Related Shayari

                    </div>

                    <div class="list-group list-group-flush">

                        <% if(related && related.length){ %>

                            <% related.forEach(item=>{ %>

                                <a
                                    href="/shayari/<%= item.slug %>"
                                    class="list-group-item list-group-item-action">

                                    <%= item.title %>

                                </a>

                            <% }) %>

                        <% } else { %>

                            <div class="list-group-item">

                                No Related Shayari.

                            </div>

                        <% } %>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>

<script>

document.getElementById("copyBtn")
?.addEventListener("click", async () => {

    await navigator.clipboard.writeText(

        document.getElementById("shayariText").innerText

    );

    alert("Shayari copied.");

});

document.getElementById("shareBtn")
?.addEventListener("click", async () => {

    const url = window.location.href;

    if (navigator.share) {

        await navigator.share({

            title: document.title,

            url

        });

    } else {

        await navigator.clipboard.writeText(url);

        alert("Link copied.");

    }

});

</script>
