<section class="py-5">

    <div class="container">

        <!-- Breadcrumb -->

        <nav
            aria-label="breadcrumb"
            class="mb-4">

            <ol class="breadcrumb">

                <li class="breadcrumb-item">

                    <a href="/">

                        Home

                    </a>

                </li>

                <li class="breadcrumb-item">

                    <a href="/tags">

                        Tags

                    </a>

                </li>

                <li
                    class="breadcrumb-item active"
                    aria-current="page">

                    #<%= tag %>

                </li>

            </ol>

        </nav>

        <!-- Header -->

        <div class="card shadow-sm border-0 mb-4">

            <div class="card-body">

                <h1 class="fw-bold">

                    #<%= tag %> Shayari

                </h1>

                <p class="text-muted mb-0">

                    <%= description || `Best Hindi Shayari related to ${tag}.` %>

                </p>

            </div>

        </div>

        <!-- Sort -->

        <div class="card shadow-sm mb-4">

            <div class="card-body">

                <form
                    action="/tag/<%= tag %>"
                    method="GET">

                    <div class="row">

                        <div class="col-md-4">

                            <select
                                name="sort"
                                class="form-select"
                                onchange="this.form.submit()">

                                <option
                                    value="latest"
                                    <%= sort==="latest" ? "selected" : "" %>>

                                    Latest

                                </option>

                                <option
                                    value="popular"
                                    <%= sort==="popular" ? "selected" : "" %>>

                                    Most Popular

                                </option>

                                <option
                                    value="likes"
                                    <%= sort==="likes" ? "selected" : "" %>>

                                    Most Liked

                                </option>

                                <option
                                    value="views"
                                    <%= sort==="views" ? "selected" : "" %>>

                                    Most Viewed

                                </option>

                            </select>

                        </div>

                    </div>

                </form>

            </div>

        </div>

        <!-- Shayari List -->

        <div class="row">

            <% if (shayari && shayari.length) { %>

                <% shayari.forEach(item => { %>

                    <div class="col-lg-4 col-md-6 mb-4">

                        <div class="card h-100 shadow-sm">

                            <% if(item.imageUrl){ %>

                                <img
                                    src="<%= item.imageUrl %>"
                                    class="card-img-top"
                                    alt="<%= item.title %>">

                            <% } %>

                            <div class="card-body">

                                <span class="badge bg-primary mb-2">

                                    <%= item.category?.name || "General" %>

                                </span>

                                <h5>

                                    <%= item.title %>

                                </h5>

                                <p>

                                    <%= item.content.substring(0,150) %>...

                                </p>

                            </div>

                            <div class="card-footer bg-white">

                                <div class="d-flex justify-content-between mb-2">

                                    <small>

                                        <i class="fa-solid fa-eye"></i>

                                        <%= item.views || 0 %>

                                    </small>

                                    <small>

                                        <i class="fa-solid fa-heart text-danger"></i>

                                        <%= item.likes || 0 %>

                                    </small>

                                    <small>

                                        <i class="fa-solid fa-calendar"></i>

                                        <%= new Date(item.createdAt).toLocaleDateString() %>

                                    </small>

                                </div>

                                <a
                                    href="/shayari/<%= item.slug %>"
                                    class="btn btn-primary btn-sm w-100">

                                    Read More

                                </a>

                            </div>

                        </div>

                    </div>

                <% }) %>

            <% } else { %>

                <div class="col-12">

                    <div class="alert alert-warning text-center">

                        No Shayari Found for this tag.

                    </div>

                </div>

            <% } %>

        </div>

        <!-- Pagination -->

        <% if (pagination && pagination.totalPages > 1) { %>

            <nav>

                <ul class="pagination justify-content-center">

                    <% for(let i=1;i<=pagination.totalPages;i++){ %>

                        <li class="page-item <%= pagination.page===i ? 'active' : '' %>">

                            <a
                                class="page-link"
                                href="?page=<%= i %>&sort=<%= sort %>">

                                <%= i %>

                            </a>

                        </li>

                    <% } %>

                </ul>

            </nav>

        <% } %>

        <!-- Related Tags -->

        <% if (relatedTags && relatedTags.length) { %>

            <div class="mt-5">

                <h4>

                    Related Tags

                </h4>

                <div class="d-flex flex-wrap gap-2 mt-3">

                    <% relatedTags.forEach(item => { %>

                        <a
                            href="/tag/<%= item %>"
                            class="btn btn-outline-primary btn-sm">

                            #<%= item %>

                        </a>

                    <% }) %>

                </div>

            </div>

        <% } %>

    </div>

</section>
